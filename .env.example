# Copy to .env.local for local overrides. Never commit real secrets.

# Public origin of the site, no trailing slash. Used for canonical URLs, Open
# Graph / Twitter images, sitemap.xml, robots.txt and JSON-LD.
# Defaults to http://localhost:3000 when unset. Set it to the production URL on
# Vercel (Project Settings > Environment Variables), e.g.:
# NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
